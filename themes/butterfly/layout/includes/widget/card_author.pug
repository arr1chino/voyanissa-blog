if theme.aside.card_author.enable
  .card-widget.card-info.text-center
    .avatar-img
      img(src=url_for(theme.avatar.img) onerror=`this.onerror=null;this.src='` + url_for(theme.error_img.flink) + `'` alt="avatar")
    .author-info-name= config.author
    .author-info-description!= theme.aside.card_author.description || config.description

    .site-data
      a(href=url_for('/'))
        .headline= _p('aside.articles')
        .length-num= site.posts.length
      a(href=url_for('/'))
        .headline= _p('aside.tags')
        .length-num= site.tags.length
      a(href=url_for('/'))
        .headline= _p('aside.categories')
        .length-num= site.categories.length

    if theme.aside.card_author.button.enable
      //- 图标改成内联 SVG。原来是 FontAwesome 的 fab fa-github，
      //- 而全站只有这一处用到 fab 图标 —— 为了一个图标要单独下载
      //- 115KB 的 fa-brands-400 字体，不划算。
      //- 这张表里没登记的图标名（以后想换成别的）会退回原来的 <i class="...">，
      //- 也就是「加图标 = 往表里加一行」。
      -
        const CARD_ICONS = {
          'fa-github': 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12'
        }
      - const btnIcon = theme.aside.card_author.button.icon || ''
      - const btnIconName = btnIcon.split(' ').pop()
      a#card-info-btn(href=theme.aside.card_author.button.link)
        if CARD_ICONS[btnIconName]
          svg.card-info-icon(viewBox='0 0 24 24', width='1em', height='1em', aria-hidden='true', focusable='false')
            path(fill='currentColor', d=CARD_ICONS[btnIconName])
        else if btnIcon
          i(class=btnIcon)
        span=theme.aside.card_author.button.text

    if(theme.social)
      .card-info-social-icons
        !=partial('includes/header/social', {}, {cache: true})
