//- ============================================================
//- 一行社交平台的样子（图标方块 + 平台名 + 账号名）。
//- 抽成 mixin 是因为下面要渲染两种外壳：能跳转的用 <a>，
//- 只能复制的（微信 / 原神）用 <button> —— 之前它们挂着 href="#"
//- 加 target="_blank"，万一脚本没跑起来点一下就会弹出一个空白标签页。
//- <button> 天生能被键盘 Tab 到、回车也能触发，比假链接更规矩。
mixin keloSocialRow(s)
  span.kelo-icon
    svg(viewBox='0 0 24 24', width='16', height='16', aria-hidden='true')
      path(fill='currentColor', d=s.d)
  span.kelo-social-name
    = s.name
    if s.handle
      span.kelo-social-handle= ' · ' + s.handle

//- ============================================================
//- Kelo 风格黑色收尾页
//- 只在首页露脸：这一整块默认 display:none，只有 html.hero-mode 时才显形
//- （hero.pug 里那行脚本给 html/body 加的 class），下面 .footer-classic 则相反。
//- 这样主题页脚模板不用区分页面类型，改起来也不会影响文章页 / 归档页。
//- ============================================================
.kelo-footer
  .kelo-bg
  .kelo-inner
    .kelo-top
      .kelo-brand
        .kelo-logo VOYANISSA
        p.kelo-desc
          | 一个把三维形象放进网页的作品集：滚动看分镜、鼠标带着镜头走，
          | 下面是文章与作品。做前端、做设计，也做点影像。
        .kelo-social
          span.kelo-social-label FOLLOW US:
          ul.kelo-social-list
            each s in SOCIALS
              - const keloCopyOnly = !s.url || s.url === '#'
              li
                if keloCopyOnly
                  button.kelo-social-item(type='button',
                    title=(s.handle ? s.name + ' · ' + s.handle : s.name),
                    aria-label=(s.handle ? s.name + ' · ' + s.handle : s.name),
                    data-hb-copy=s.copy, data-hb-copy-tip=s.copyTip)
                    +keloSocialRow(s)
                else
                  a.kelo-social-item(href=s.url, target='_blank', rel='noopener',
                    title=(s.handle ? s.name + ' · ' + s.handle : s.name),
                    aria-label=(s.handle ? s.name + ' · ' + s.handle : s.name))
                    +keloSocialRow(s)
      .kelo-navs
        .kelo-col
          h2 站点
          a(href=url_for('/')) 首页
          a(href=url_for('/calendar/')) 日历日程
          a(href=url_for('/chat/')) 和沃聊天
        .kelo-col
          h2 文章
          each post in site.posts.sort('-date').limit(4).toArray()
            a(href=url_for(post.path))= post.title
        .kelo-col
          h2 链接
          a(href='https://bistumaker.cn/', target='_blank', rel='noopener') 创客空间
          a(href='https://ys.mihoyo.com/', target='_blank', rel='noopener') 原神官网
          a(href='https://github.com/arr1chino/voyanissa-blog', target='_blank', rel='noopener') 网站源码
    .kelo-legal
      span 模型提供 miHoYo · 改造 观海子 · 仅作学习展示
      span
        if sinceYear && sinceYear != currentYear
          != `&copy;&nbsp;${sinceYear} - ${currentYear} By ${config.author}`
        else
          != `&copy;&nbsp;${currentYear} By ${config.author}`
      span
        = _p('footer.framework') + ' '
        a(href='https://hexo.io')= `Hexo${ v ? ' ' + v.hexo : '' }`
        span.footer-separator |
        = _p('footer.theme') + ' '
        a(href='https://github.com/jerryc127/hexo-theme-butterfly')= `Butterfly${ v ? ' ' + v.theme : '' }`

//- 下面这一整块是主题原本的页脚，原样保留 —— 非首页照旧走它
.footer-classic
  if nav
    .footer-flex
      for block in nav
        .footer-flex-items(style=`${ block.width ? 'flex-grow:' + block.width : '' }`)
          for blockItem in block.content
            .footer-flex-item
              .footer-flex-title= blockItem.title
              .footer-flex-content
                for subitem in blockItem.item
                  if subitem.html
                    div!= subitem.html
                  else if subitem.url
                    a(href=url_for(subitem.url), target='_blank' title=subitem.title)= subitem.title
                  else if subitem.title
                    div!= subitem.title
  .footer-other
    .footer-copyright
      if owner.enable
        span.copyright
          if sinceYear && sinceYear != currentYear
            != `&copy;&nbsp;${sinceYear} - ${currentYear} By ${config.author}`
          else
            != `&copy;&nbsp;${currentYear} By ${config.author}`
      if copyright.enable
        span.framework-info
          if owner.enable && nav
            span.footer-separator |
          span= _p('footer.framework') + ' '
          a(href='https://hexo.io')= `Hexo${ v ? ' ' + v.hexo : '' }`
          span.footer-separator |
          span= _p('footer.theme') + ' '
          a(href='https://github.com/jerryc127/hexo-theme-butterfly')= `Butterfly${ v ? ' ' + v.theme : '' }`
    if theme.footer.custom_text
      .footer_custom_text!= theme.footer.custom_text
