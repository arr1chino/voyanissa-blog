extends includes/layout.pug

block content
  script document.body.classList.add('hero-mode'); document.documentElement.classList.add('hero-mode')
  #hero
    //- 首屏加载遮罩。3D 模型要在浏览器里解析一段时间（网速 + 机器决定），
    //- 这段时间画布是空的；以前就是「进来先看见一片空海，人过一会儿才浮出来」。
    //- 现在先用这一层盖住，等 hero.js 报到 ready 再整层淡出。
    //- 加载页铺的就是素材本身：B 站那段在动的水环（见下面 video 上面的注释）。
    .hero-loader#hero-loader
      //- 兜底底色：只在这条视频播不出来的时候才看得见（断网 / 禁自动播放）。
      //- 视频是纯黑的，铺满之后就把它盖住了，平时根本不露面。
      .hero-loader-veil
      //- r124：把「第一帧」从 video 的 poster 属性挪成一张真 <img>。
      //- poster 属性画出来的东西浏览器不算「最大内容」，所以整页的 LCP
      //- 一直被卡在遮罩淡出之后才出现的文字上（实测 3.3 秒）。换成 <img>
      //- 之后它自己是首屏最大的图，从第一帧起就算数，LCP 直接提前到图片加载完。
      //- 画面和 poster 一模一样（同一张 loader-poster.webp），下面那条 video
      //- 一解出真帧就把它盖住，肉眼看不出区别。
      img.hero-loader-poster(
        src='/img/loader-poster.webp' alt='' aria-hidden='true'
        fetchpriority='high' decoding='async')
      //- 加载页的主角：B 站素材里那圈在动的水环。原片 44 秒、右上角带着原 UP 主的水印，
      //- 这里把水印裁掉了，取中间 10 秒「正放 + 倒放」拼成 20 秒无缝循环，压成
      //- /img/loader-ring.mp4（960×960、约 1.1MB、无音轨）。黑的地方不抠图 ——
      //- 整帧铺在遮罩上，黑就是加载页的底色，四周自然无缝。
      //-
      //- poster 是同一段素材的第一帧，视频解出第一帧之前先顶着它，免得进来先闪一下纯黑。
      //- 这一条很关键：模型解析那会儿主线程是堵的，光等 video 的 playing 事件会白等
      //- 一两秒，那段时间就会露回以前那圈纯 CSS 水波（报到的时机以前就是这么迟的）。
      //- 视频是独立解码的，不吃主线程，铺上去之后从第一帧起就是素材本身在动。
      video.hero-loader-video(
        autoplay='' muted='' loop='' playsinline='' preload='auto'
        poster='/img/loader-poster.webp' aria-hidden='true' tabindex='-1')
        source(src='/img/loader-ring.mp4' type='video/mp4')
      p.hero-loader-title 沃雅妮莎
      p.hero-loader-sub#hero-loader-sub 正在浮出水面…
    .hero-flow
    .hero-frame
    .hero-scroll
      .hero-sticky
        canvas.hero-canvas
        .hero-fx
          .hero-fx-blur
          .hero-fx-shade
        .hero-vignette
        .hero-panels
          //- 0：开场那一屏，不放资料卡。
          //-    页面最顶上（沃雅妮莎头顶那块空白里）是「组成我的 —— 打字机」，
          //-    中间那组艺术字从上往下是「沃雅妮莎激推！！/ About Me / WELCOME」。
          //-    想换那句循环播放的词，改 /js/hero.js 里的 ABOUT_WORDS 清单。
          .hero-panel.hero-panel--about(data-index='0')
            .hero-about-top
              .hero-about-line
                span.hero-about-lead 组成我的 ——
                span.hero-about-word#hero-about-word
            .hero-about
              .hero-about-name 沃雅妮莎激推！！
              .hero-about-kicker About Me
              .hero-about-welcome WELCOME
          .hero-panel(data-index='1')
            .hero-panel-inner
              .hero-kicker 01 / 你好
              h2 关于这个形象
              p
                | 这个界面用3D建模设计
                br
                | 滚动就能看到不同角度
          .hero-panel(data-index='2')
            .hero-panel-inner
              .hero-kicker 02 / 我在做什么
              h2 管院大一·狂暴学习中
              p 筹备摄影策划，准备机器人比赛，coding社团任务中。。
              .hero-tags
                span 二次元摄影
                span 排球
                span 专业课
                span 建模
          .hero-panel(data-index='3')
            .hero-panel-inner
              .hero-kicker 03 / 转过身
              h2 我的爱好超级多，待开发…
              p 来和我交朋友
          .hero-panel(data-index='4')
            .hero-panel-inner
              .hero-kicker 04 / 近一点
              h2 关于这个网站
              p
                | coding by deepseek v4.1 flash
                br
                | 蓝色大肥鱼很好用哦
          .hero-panel(data-index='5')
            .hero-panel-inner
              .hero-kicker 05 / 继续向下
              h2 下面是博客
              p 文章、作品和联系方式都排在后面。
        .hero-hint 向下滚动
        .hero-credit 模型提供 miHoYo · 改造 观海子 · 仅作学习展示
    //- ============================================================
    //- 白卡里的博客页：左中右三列
    //-   左右两列是窄的小模块（资料卡、站点统计、天气、歌单…），
    //-   中间一列是文章大卡：右侧挂一块渐变「封面」，左边是标题 / 日期 / 摘要 / 标签。
    //-   封面默认用 CSS 画的渐变，不依赖任何图片；哪篇文章在 front-matter 里
    //-   写了 cover，那张卡就改用真图（渐变自动让位）。
    //-   文章数是自动的：_posts 里有几篇就出几张卡，不用改模板。
    //- ============================================================
    - const posts = site.posts.sort('-date').toArray()
    - const sinceYear = theme.footer.owner.since || 2025
    - const uptimeDays = Math.max(1, Math.floor((Date.now() - new Date(sinceYear + '/01/01 00:00:00').getTime()) / 86400000))
    - const lastUpdate = posts.length ? date(posts[0].date, 'YYYY-MM-DD') : '—'
    section.hero-after
      .hero-tab-card
        .hero-blog
          aside.hero-blog-col.hero-blog-col--side
            .hb-card.hb-profile
              .hb-avatar
                img(src=url_for(theme.avatar.img) alt='头像')
              .hb-name= config.author
              .hb-tagline= config.subtitle
              .hb-stats
                .hb-stat
                  b= site.posts.length
                  span 文章
                .hb-stat
                  b= site.categories.length
                  span 分类
                .hb-stat
                  b= site.tags.length
                  span 标签
            //- 友情链接：一行一个，图标自动抓对方网站的标签页小图标。
            //- 要加人 / 改名字，改 /js/hb-widgets.js 顶上那份 FRIENDS 清单。
            .hb-card.hb-links-card
              h3.hb-card-title 友情链接
              ul.hb-links-list#hb-links-list
            //- 本月日程：一张小小的缩略月历（今天 / 节日 / 自己批注过的日子
            //- 都有标记），整张卡点一下就去 /calendar/ 那一页写日程。
            //- 画格子的人是 /js/hb-minical.js，节日数据在 /js/hb-holidays.js。
            a.hb-card.hb-mini-cal-card#hb-mini-cal(href=url_for('/calendar/'),
              aria-label='打开日程日历，可以自己批注')
              h3.hb-card-title
                | 本月日程
                span.hb-beta 测试中
              .hb-mini-cal-month
                b#hb-mini-cal-month ——
                span.hb-mc-more 查看全部
                  i.fas.fa-chevron-right
              .hb-mini-cal-grid#hb-mini-cal-grid
              .hb-mini-cal-fests#hb-mini-cal-fests
              p.hb-mini-cal-foot#hb-mini-cal-foot
            //- 和沃聊天：点进去是单独一页（/chat/），那边接的是 Cloudflare 上的中转站。
            //- 钥匙和她的完整人设都锁在中转站里，网页这边一个字节都看不到。
            //- 入口想改文案就改这几行；要换接口地址去改 /js/hb-chat.js 顶上那个常量。
            a.hb-card.hb-chat-card#hb-chat-card(href=url_for('/chat/'),
              aria-label='和沃雅妮莎聊两句')
              h3.hb-card-title 和沃聊天
              .hb-chat-row
                span.hb-chat-orb(aria-hidden='true')
                  i.fas.fa-water
                span.hb-chat-text
                  b 沃雅妮莎在水底等着
                  em 点一下就能跟她说说话
              span.hb-chat-go 去找她
                i.fas.fa-chevron-right
          main.hero-blog-col.hero-blog-col--main
            h2.hb-list-title.reveal
              | 最新文章
              span.hb-list-count= posts.length + ' 篇'
            .hb-posts
              each post, i in posts
                - const brief = strip_html(post.excerpt || post.content).replace(/\s+/g, ' ').trim().slice(0, 76)
                - const cat = post.categories && post.categories.length ? post.categories.first().name : ''
                article.hb-post.reveal
                  span.hb-post-art(aria-hidden='true')
                    span.hb-post-art-img(
                      class=post.cover ? false : 'hb-art-' + (i % 5),
                      style=post.cover ? `background-image:url('${url_for(post.cover)}')` : false)
                  .hb-post-body
                    h3.hb-post-title
                      a(href=url_for(post.path), tabindex='-1')= post.title
                    .hb-post-meta
                      span.hb-meta-item
                        i.fas.fa-calendar-alt
                        = date(post.date, 'YYYY-MM-DD')
                      if cat
                        span.hb-meta-item
                          i.fas.fa-folder-open
                          = cat
                    p.hb-post-excerpt= brief + '…'
                    if post.tags && post.tags.length
                      .hb-post-tags
                        each t in post.tags.toArray().slice(0, 4)
                          span.hb-tag= '#' + t.name
                  //- 铺满整张卡的链接：卡片上任何位置都能点进文章
                  a.hb-post-hit(href=url_for(post.path), aria-label=post.title)
                  //- 右下角那枚圆钮：只在鼠标停到卡上时滑出来（纯装饰，点它等于点整张卡）
                  span.hb-post-arrow(aria-hidden='true')
                    i.fas.fa-arrow-right
          aside.hero-blog-col.hero-blog-col--side
            //- 定位天气：问浏览器要位置 → 当地实况（脚本在 /js/hb-weather.js）
            .hb-card.hb-weather-card#hb-weather-card
              h3.hb-card-title 你在的地方
              .hb-weather-top
                i.fas.fa-cloud#hb-weather-icon
                b#hb-weather-temp ——
              p.hb-weather-city#hb-weather-city 正在定位…
              p.hb-weather-desc#hb-weather-desc
              p.hb-weather-foot#hb-weather-foot
            //- 今日一言：进页面自动拉一句，点卡片任意位置换一句（脚本在 /js/hb-widgets.js）
            .hb-card.hb-quote-card#hb-quote-card
              h3.hb-card-title 今日一言
              p.hb-quote#hb-hitokoto 正在打捞今天的句子…
              p.hb-quote-from#hb-hitokoto-from —— 一言
              p.hb-card-hint 点一下换一句
            //- 随机音乐：每次进来随机挑一首，点一下再随机换一首（脚本在 /js/hb-widgets.js）
            //- 歌单和封面配色都在那份脚本的 SONGS 清单里，想加歌就照格式加一行。
            //- 真正出声的是这张卡里藏着的浏览器播放器，画面上的进度条和圆钮都是自己画的，
            //- 所以不会再弹出网易云官方播放器那个白色方框。
            .hb-card.hb-music-card#hb-music-card
              h3.hb-card-title 网易云 · 每日三首
              .hb-music-now
                span.hb-music-kicker 正在播放
                .hb-music-info
                  b#hb-music-name 正在挑歌…
                  span#hb-music-artist
                .hb-music-btns
                  button.hb-music-toggle#hb-music-toggle(type='button' title='播放 / 暂停' aria-label='播放或暂停')
                    i.fas.fa-play
              .hb-music-bar#hb-music-bar(role='slider' tabindex='0' aria-label='播放进度')
                span.hb-music-bar-bg
                  span.hb-music-bar-fill#hb-music-fill
                .hb-music-times
                  span#hb-music-cur 00:00
                  span.hb-music-time-sep /
                  span#hb-music-dur --:--
              ul.hb-music.hb-music-batch#hb-music-batch
              .hb-music-foot
                button.hb-music-more#hb-music-more(type='button' title='换一批' aria-label='换一批')
                  i.fas.fa-rotate
                  span 换一批
                span.hb-music-note#hb-music-note
              audio#hb-music-audio(preload='none')
              p.hb-card-hint 点歌名直接播 · 三首放完自动换下一组

  //- 惯性滚动（Lenis）：和 greymac 用的是同一个库、同一个版本。
  //- 只挂在首页，文章页/归档页还是浏览器原生滚动。
  script(src='/js/lenis.min.js')
  script(type='module', src='/js/hero.js')
  //- 网易云的曲子清单（从公开接口取回、逐首验过能放的），要排在挂件脚本前面
  script(src='/js/hb-songs.js')
  //- 首页右栏那两个小挂件：今日一言（hitokoto）+ 每日三首（网易云外链）
  script(src='/js/hb-widgets.js')
  //- 定位天气小卡片
  script(src='/js/hb-weather.js')
  //- 侧栏那张「本月日程」小日历：节日数据在前，画格子的在后
  script(src='/js/hb-holidays.js')
  script(src='/js/hb-minical.js')
